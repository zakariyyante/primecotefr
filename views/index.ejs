<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head') %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": "https://<%= site.domain %>/",
    "name": "<%= site.fullSiteName %>",
    "description": "<%= page.description %>",
    "inLanguage": "fr-FR"
  }
  </script>
</head>
<body class="bg-gray-50 text-gray-900">
  <%- include('partials/age-gate') %>

  <!-- Disclosure Bar -->
  <div class="bg-gray-100 py-2 border-b border-gray-200">
    <div class="container mx-auto px-4 text-[10px] md:text-xs font-bold text-gray-500 uppercase tracking-widest flex flex-wrap justify-center gap-4">
      <span>18+</span>
      <span>Réservé aux adultes</span>
      <span>Jeu responsable</span>
      <span class="text-accent">ANJ</span>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-white pt-12 pb-20 border-b border-gray-100">
    <div class="container mx-auto px-4 text-center">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 bg-accent/10 rounded-full text-accent text-xs font-bold uppercase tracking-widest mb-10">
        <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
        <span>Marché français · ANJ</span>
      </div>
      
      <div class="flex items-center justify-center space-x-1 text-5xl md:text-7xl font-black tracking-tighter mb-4">
        <span class="text-gray-900"><%= site.wordmark.first %></span><span class="text-accent"><%= site.wordmark.second %></span><span class="text-gray-400">FR</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 max-w-4xl mx-auto leading-tight mb-6">
        Les Meilleures Plateformes de <span class="text-accent">Jeux en France</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed mb-10">
        Un espace d'information indépendant, centré sur la fiabilité et la conformité. Nous analysons les opérateurs certifiés pour vous offrir les meilleurs services.
      </p>

      <div class="flex flex-wrap justify-center gap-4 items-center mb-8">
        <span class="bg-gray-100 text-gray-700 text-xs font-bold px-4 py-2 rounded-full flex items-center">
          <svg class="w-3.5 h-3.5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"></path></svg>
          Mis à jour · <%= today %>
        </span>
      </div>

      <div class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-[0.2em]">
        PRATIQUE RESPONSABLE · INFORMATIONS INDÉPENDANTES
      </div>
    </div>
  </section>

  <!-- Advertiser Disclosure -->
  <div class="container mx-auto px-4 -mt-6 relative z-10">
    <div class="bg-white border border-gray-200 rounded-full px-6 py-2 shadow-sm text-[10px] md:text-xs text-center text-gray-500 max-w-3xl mx-auto">
      <span class="font-bold uppercase tracking-tighter mr-2">Divulgation de l'Annonceur :</span> 
      18+ T&C s'appliquent | Jouez avec Responsabilité. Nous recevons parfois une commission des opérateurs listés sans surcoût pour l'utilisateur.
    </div>
  </div>

  <!-- Main Rankings -->
  <main class="py-20">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black mb-4">Notre Sélection Premium</h2>
        <p class="text-gray-600">Classement des opérateurs et de leurs offres pour la France — avantages, services et fiabilité comparés.</p>
      </div>
      <div class="space-y-6">
        <% operators.forEach(op => { %>
          <div class="bg-white border-2 border-transparent hover:border-accent/30 rounded-3xl shadow-xl shadow-gray-200/50 overflow-hidden transition-all duration-300 relative group">
            <a href="<%= op.ctaUrl %>" target="_blank" rel="sponsored nofollow" class="absolute inset-0 z-0"></a>
            
            <div class="flex flex-col lg:flex-row items-center p-6 lg:p-8 gap-8 relative z-10">
              <div class="flex flex-row lg:flex-col items-center justify-between lg:justify-center w-full lg:w-48 text-center space-y-4">
                <div class="bg-accent text-white font-black text-xl py-2 px-6 rounded-2xl shadow-lg shadow-accent/20">
                  <%= op.badgeText %>
                </div>
                <div class="w-32 lg:w-40 h-20 flex items-center justify-center p-4 rounded-2xl <%= op.logoBg === 'dark' ? 'bg-gray-900' : 'bg-gray-50 border border-gray-100' %>">
                  <% if (op.logoImage) { %>
                    <img src="<%= op.logoImage %>" alt="<%= op.name %>" class="max-h-full max-w-full object-contain" onerror="this.parentElement.innerHTML='<span class=\'font-black text-xl text-gray-400\'><%= op.name %></span>'">
                  <% } else { %>
                    <span class="font-black text-xl text-gray-400"><%= op.name %></span>
                  <% } %>
                </div>
              </div>

              <div class="flex-1 text-center lg:text-left w-full">
                <div class="mb-2">
                  <h3 class="text-gray-400 text-xs font-bold uppercase tracking-widest"><%= op.bonusLabel %></h3>
                  <div class="text-2xl md:text-4xl font-black text-gray-900"><%= op.bonusValue %></div>
                </div>
                <div class="flex items-center justify-center lg:justify-start space-x-2 mb-4">
                  <div class="flex text-yellow-400">
                    <% for(let i=0; i<5; i++) { %>
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                    <% } %>
                  </div>
                  <span class="text-gray-900 font-bold"><%= op.rating %>/10</span>
                </div>
                <p class="text-[10px] text-gray-400 leading-tight"><%= op.disclaimer %></p>
              </div>

              <div class="w-full lg:w-auto text-center">
                <a href="<%= op.ctaUrl %>" target="_blank" rel="sponsored nofollow" class="inline-flex items-center justify-center bg-accent hover:bg-accent/90 text-white font-bold text-lg py-5 px-10 rounded-2xl transition-all shadow-xl shadow-accent/20 group-hover:scale-105 pointer-events-none">
                  <%= op.ctaLabel %>
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
                <div class="mt-4 text-xs text-gray-500 font-medium">Offre vérifiée aujourd'hui</div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <!-- Why Choose Us -->
  <section class="py-24 bg-white border-y border-gray-100">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black mb-4 text-gray-900 tracking-tight">Pourquoi nous faire confiance ?</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Nous valorisons la clarté, la sécurité et la conformité — des critères stables pour comparer les meilleures offres.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="p-8 bg-gray-50 rounded-3xl border border-gray-100">
          <div class="w-12 h-12 bg-accent/10 text-accent rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Sécurité Maximale</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Nous ne listons que des opérateurs encadrés par l'ANJ, avec des licences vérifiables et des pratiques conformes.</p>
        </div>
        <div class="p-8 bg-gray-50 rounded-3xl border border-gray-100">
          <div class="w-12 h-12 bg-accent/10 text-accent rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12z"></path></svg>
          </div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Offres Claires</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Promotions expliquées sans artifice : nous vous aidons à identifier les bonus réalistes et transparents.</p>
        </div>
        <div class="p-8 bg-gray-50 rounded-3xl border border-gray-100">
          <div class="w-12 h-12 bg-accent/10 text-accent rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          </div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Gestion des Flux</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Délais de retrait et méthodes de paiement : des critères techniques concrets pour comparer au-delà du visuel.</p>
        </div>
        <div class="p-8 bg-gray-50 rounded-3xl border border-gray-100">
          <div class="w-12 h-12 bg-accent/10 text-accent rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-2.753-9.571A9.033 9.033 0 0112 2c1.947 0 3.766.617 5.247 1.669m-4.247 11.222A9.033 9.033 0 0122 11c0 1.55-.389 3.008-1.077 4.281m-7.077 4.281A9.033 9.033 0 0112 22c-1.254 0-2.455-.255-3.543-.718m0 0A8.967 8.967 0 015 18c.678-.34 1.345-.727 2-1.151"></path></svg>
          </div>
          <h3 class="font-bold text-xl mb-3 text-gray-900">Analyses Fixes</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Une grille stable et des tests reproductibles pour des fiches comparables, sans classement aléatoire.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Evaluate -->
  <section class="py-24 bg-gray-50">
    <div class="container mx-auto px-4 max-w-4xl text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-black mb-4 tracking-tight">Notre Méthode d'Évaluation</h2>
      <p class="text-gray-600">Une grille fixe pour des fiches comparables, moins de subjectivité, plus de repères.</p>
    </div>
    <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white p-10 rounded-3xl border border-gray-100 shadow-sm">
        <h3 class="font-bold text-xl mb-4 text-gray-900">Régulation Française</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Nous contrôlons la validité de l'agrément ANJ et la conformité des messages avec les obligations locales.</p>
      </div>
      <div class="bg-white p-10 rounded-3xl border border-gray-100 shadow-sm">
        <h3 class="font-bold text-xl mb-4 text-gray-900">Transparence des Bonus</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Conditions de mise, plafonds et durées sont résumés pour repérer vite les offres les plus réalistes.</p>
      </div>
      <div class="bg-white p-10 rounded-3xl border border-gray-100 shadow-sm">
        <h3 class="font-bold text-xl mb-4 text-gray-900">Support de Qualité</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Nous évaluons la disponibilité et la clarté des réponses en français pour vos besoins concrets.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black mb-4 text-gray-900 tracking-tight">Questions fréquentes</h2>
        <p class="text-gray-600">Réponses courtes sur la régulation, les paiements et le jeu responsable.</p>
      </div>
      
      <div class="space-y-4">
        <% faq.forEach((item, index) => { %>
          <div class="bg-gray-50 rounded-2xl border border-gray-200 overflow-hidden">
            <button class="w-full flex items-center justify-between p-6 text-left hover:bg-gray-100 transition" onclick="toggleFaq(<%= index %>)">
              <span class="font-bold text-lg text-gray-900"><%= item.question %></span>
              <svg id="faq-icon-<%= index %>" class="w-6 h-6 text-accent transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="faq-answer-<%= index %>" class="hidden p-6 pt-0 text-gray-600 leading-relaxed border-t border-gray-100">
              <%= item.answer %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Information, fiabilité et conformité -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="space-y-12">
          <div>
            <h2 class="text-3xl font-black mb-8 border-l-4 border-accent pl-6 text-gray-900 uppercase tracking-tight">Information, fiabilité et conformité</h2>
            <p class="text-gray-600 leading-relaxed font-medium">
              Pour assurer la protection de nos utilisateurs, <strong><%= site.fullSiteName %></strong> collabore exclusivement avec des plateformes reconnues pour leur sérieux, leur transparence et leur conformité réglementaire. Cette sélection rigoureuse vise à garantir un environnement en ligne fiable, équilibré et sécurisé pour tous.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-gray-900 mb-3 uppercase tracking-wider text-sm">Conditions et confidentialité</h3>
              <p class="text-sm text-gray-500 leading-relaxed">
                En naviguant sur ce site, vous reconnaissez et acceptez nos Conditions d'utilisation ainsi que notre Politique de confidentialité.
              </p>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-3 uppercase tracking-wider text-sm">Propriété intellectuelle</h3>
              <p class="text-sm text-gray-500 leading-relaxed">
                L'ensemble du contenu disponible sur ce site est protégé par la législation sur la propriété intellectuelle. Toute copie est interdite sans accord préalable.
              </p>
            </div>
          </div>

          <div class="bg-white p-8 rounded-[2rem] border border-gray-200 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-accent/5 rounded-full -mr-10 -mt-10 transition-transform group-hover:scale-150"></div>
            <h3 class="font-bold text-gray-900 mb-4 flex items-center uppercase tracking-wider text-sm">
              <svg class="w-5 h-5 text-accent mr-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
              Jeu responsable
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">
              Le contenu de ce site s'adresse uniquement aux personnes majeures âgées de 18 ans et plus. Pour toute information ou soutien, consultez gambleaware.org ou gamcare.org.uk.
            </p>
            <p class="text-sm font-bold text-gray-900 italic">
              En France, Joueurs Info Service : <span class="text-accent underline">09 74 75 13 13</span> (non surtaxé).
            </p>
          </div>
        </div>
        
        <div class="bg-gray-900 rounded-[3rem] p-10 text-white shadow-2xl relative overflow-hidden group h-fit">
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-accent/20 rounded-full blur-3xl transition-transform group-hover:scale-150"></div>
          
          <h3 class="text-2xl font-bold mb-8 flex items-center text-white">
            <span class="w-10 h-10 bg-red-500 rounded-full flex items-center justify-center mr-4 shadow-lg shadow-red-500/30">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.268 17c-.77 1.333.192 3 1.732 3z"></path></svg>
            </span>
            Assistance Jeu Responsable
          </h3>
          <p class="text-gray-400 mb-8 leading-relaxed">
            Le jeu doit rester un plaisir. Pour toute information ou soutien, tournez-vous vers les services d'aide officiels disponibles 24h/24.
          </p>
          <div class="space-y-6">
            <div class="flex items-center space-x-4 p-5 bg-white/5 rounded-2xl border border-white/10">
              <div class="bg-accent/20 p-3 rounded-xl text-accent font-black">ANJ</div>
              <div>
                <div class="text-xs font-bold uppercase tracking-wider text-gray-500">Service Officiel</div>
                <div class="text-xl font-bold"><%= site.helpline.phone %></div>
              </div>
            </div>
            <a href="/jeu-responsable.html" class="block w-full text-center bg-white text-gray-900 font-bold py-4 rounded-2xl hover:bg-accent hover:text-white transition-all shadow-xl shadow-black/20">
              Pratique Responsable
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    function toggleFaq(index) {
      const answer = document.getElementById(`faq-answer-${index}`);
      const icon = document.getElementById(`faq-icon-${index}`);
      answer.classList.toggle('hidden');
      icon.classList.toggle('rotate-180');
    }
  </script>
</body>
</html>
