<% if (page.key !== 'home') { %>
<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm py-4">
  <div class="container mx-auto px-4 flex items-center justify-between">
    <a href="/" class="flex items-center space-x-1 text-2xl font-black tracking-tighter">
      <span class="text-gray-900"><%= site.wordmark.first %></span><span class="text-accent"><%= site.wordmark.second %></span><span class="text-gray-400">FR</span>
    </a>
    
    <a href="/" class="inline-flex items-center text-sm font-semibold text-gray-500 hover:text-accent transition">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Retour à l'accueil
    </a>
  </div>
</header>
<% } %>
