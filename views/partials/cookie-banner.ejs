<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[9998] bg-white border-t border-gray-100 shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)] p-4 md:p-6 transition-transform duration-500 translate-y-full">
  <div class="container mx-auto max-w-6xl flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex-1">
      <h4 class="text-gray-900 font-bold mb-1 tracking-tight">Gestion des cookies</h4>
      <p class="text-sm text-gray-500 leading-relaxed">
        Nous utilisons des cookies pour améliorer votre expérience, analyser le trafic et diffuser des contenus adaptés. En continuant, vous acceptez notre <a href="/politique-cookies.html" class="text-accent hover:underline font-semibold">politique relative aux cookies</a>.
      </p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <button id="cookie-accept" class="bg-accent hover:bg-accent/90 text-white font-bold py-3 px-8 rounded-xl transition shadow-lg shadow-accent/20 text-sm uppercase tracking-widest">
        Tout accepter
      </button>
      <button id="cookie-decline" class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold py-3 px-8 rounded-xl transition text-sm uppercase tracking-widest">
        Refuser
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');
    
    if (!localStorage.getItem('cookie-consent')) {
      setTimeout(() => {
        banner.classList.remove('translate-y-full');
      }, 1000);
    }

    acceptBtn.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'accepted');
      banner.classList.add('translate-y-full');
    });

    declineBtn.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'declined');
      banner.classList.add('translate-y-full');
    });
  })();
</script>
